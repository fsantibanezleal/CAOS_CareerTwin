# Public configuration contract. Copy to .env and supply private values locally.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CAREERTWIN_BIND_PORT=8000
APP_PUBLIC_URL=http://localhost:8000
APP_SECRET_KEY=
APP_CSRF_SECRET=
POSTGRES_PASSWORD=
DATABASE_URL=sqlite:///./data/private/careertwin.sqlite3
REDIS_URL=redis://localhost:6379/0
BLOB_ROOT=./data/blobs
BLOB_ENCRYPTION_KEY=
BLOB_ENCRYPTION_KEY_ID=local-v1
CONNECTOR_ENCRYPTION_KEY=
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8000"]
SECURE_COOKIES=false
TRUSTED_PROXY_COUNT=0
LLM_DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:0.5b-instruct-q4_K_M
SEMANTIC_MATCHING_ENABLED=true
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m
LLM_REQUEST_TIMEOUT_SECONDS=300
LLM_CONTEXT_WINDOW=4096
LLM_MAX_OUTPUT_TOKENS=1024
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DOCLING_URL=http://docling:5001
DOCLING_API_KEY=
DOCLING_TIMEOUT_SECONDS=300
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
CONNECTOR_SYNC_TIMEOUT_SECONDS=30
EMAIL_RETENTION_DAYS=365
WORKER_MAX_JOBS=2
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
CLAMAV_HOST=
CLAMAV_PORT=3310
