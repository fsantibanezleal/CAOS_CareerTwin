**
!.dockerignore
!Dockerfile
!pyproject.toml
!requirements.txt
!README.md
!alembic.ini
!alembic/
!alembic/**
!backend/
!backend/**
!docling_gateway/
!docling_gateway/**
!docker/
!docker/docling/
!docker/docling/patches/
!docker/docling/patches/*.patch
!extension/
!extension/**
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**

# Defense in depth: private and generated paths never enter a Docker build context.
.env
.env.*
!.env.example
.git
.venv
.run
backups
data
frontend/node_modules
frontend/dist
**/__pycache__
**/*.pyc
